{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "OpenKern design tokens v1.0-rc. Machine-readable source of truth. Color is state, not decoration.",
  "color": {
    "dark": {
      "background": { "$value": "#0C0F0E", "$type": "color" },
      "surface": { "$value": "#131715", "$type": "color" },
      "surface-2": { "$value": "#1A1F1C", "$type": "color" },
      "border": { "$value": "#242B28", "$type": "color" },
      "border-strong": { "$value": "#333B37", "$type": "color" },
      "text": { "$value": "#E9EDEA", "$type": "color" },
      "text-dim": { "$value": "#A8B3AD", "$type": "color" },
      "text-mute": { "$value": "#7B877F", "$type": "color" },
      "state-allow": { "$value": "#57B87B", "$type": "color" },
      "state-ask": { "$value": "#D9A03F", "$type": "color" },
      "state-deny": { "$value": "#DE685E", "$type": "color" },
      "state-info": { "$value": "#6FA8C4", "$type": "color" }
    },
    "light": {
      "background": { "$value": "#F4F5F4", "$type": "color" },
      "surface": { "$value": "#FFFFFF", "$type": "color" },
      "surface-2": { "$value": "#EBEEEC", "$type": "color" },
      "border": { "$value": "#D8DDDA", "$type": "color" },
      "border-strong": { "$value": "#BFC7C2", "$type": "color" },
      "text": { "$value": "#141715", "$type": "color" },
      "text-dim": { "$value": "#4A544E", "$type": "color" },
      "text-mute": { "$value": "#687269", "$type": "color" },
      "state-allow": { "$value": "#22794A", "$type": "color" },
      "state-ask": { "$value": "#7F630D", "$type": "color" },
      "state-deny": { "$value": "#B03A31", "$type": "color" },
      "state-info": { "$value": "#2E6E8E", "$type": "color" }
    }
  },
  "type": {
    "family-mono": { "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily" },
    "family-body": { "$value": "Geist, system-ui, -apple-system, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif", "$type": "fontFamily" },
    "family-display": { "$value": "'JetBrains Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace", "$type": "fontFamily" },
    "scale": { "$value": [12, 13.5, 15, 17, 21, 27, 34, 44], "$type": "dimension", "$description": "px at 1rem=16; ratio ~1.26 above 15" },
    "weight-regular": { "$value": 400 }, "weight-medium": { "$value": 500 }, "weight-bold": { "$value": 700 },
    "leading-body": { "$value": 1.6 }, "leading-tight": { "$value": 1.25 },
    "tracking-label": { "$value": "0.12em", "$description": "uppercase mono labels only" }
  },
  "spacing": { "unit": { "$value": 4 }, "steps": { "$value": [4, 8, 12, 16, 24, 32, 48, 64, 96] } },
  "radius": {
    "small": { "$value": 4 }, "medium": { "$value": 8 }, "large": { "$value": 12 },
    "$description": "No pill radii on structural surfaces; state chips may use 999."
  },
  "border": { "hairline": { "$value": 1 }, "emphasis": { "$value": 2 } },
  "shadow": {
    "level-1": { "$value": "0 1px 2px rgba(0,0,0,.30)" },
    "level-2": { "$value": "0 8px 24px rgba(0,0,0,.28)" },
    "$description": "Shadows are depth cues only; never glow, never colored."
  },
  "motion": {
    "duration-fast": { "$value": "120ms" },
    "duration-base": { "$value": "180ms" },
    "duration-slow": { "$value": "240ms" },
    "easing": { "$value": "cubic-bezier(0.2, 0, 0, 1)" },
    "cursor-blink": { "$value": "1.1s step-end infinite", "$description": "the single signature motion" },
    "reduced-motion": { "$value": "respect prefers-reduced-motion: blink stops, transitions collapse to 0ms; motion is not identity for OpenKern" }
  },
  "state": {
    "vocabulary": ["ALLOW", "ASK", "DENY", "REFUSED", "VERIFIED", "UNVERIFIED", "EXECUTED", "UNSUPPORTED", "BLOCKED"],
    "$description": "State is rendered as label + icon + color, never color alone."
  }
}
